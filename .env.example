# Kredensial Firebase Authentication KimiKoli
# Dapatkan kredensial ini dari Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=kimikoli-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kimikoli-app
VITE_FIREBASE_STORAGE_BUCKET=kimikoli-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
