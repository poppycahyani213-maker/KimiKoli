rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi pembantu verifikasi apakah akun yang sedang login adalah Guru
    function isTeacher() {
      return request.auth != null && 
        (request.auth.token.email.matches('.*@kimikoli\\.sch\\.id') || 
         request.auth.token.email in ['poppycahyani213@gmail.com', 'guru@kimikoli.sch.id']);
    }

    // Rekap nilai seluruh siswa: HANYA Guru yang dapat membaca
    match /student_records/{recordId} {
      allow read: if isTeacher();
      allow write: if request.auth != null;
    }

    // Data progres per siswa: Siswa hanya dapat membaca & menulis progres miliknya sendiri
    match /user_progress/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isTeacher());
    }

    // Koleksi default
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
  }
}
